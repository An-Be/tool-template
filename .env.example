# Server-only. Never prefix these with NEXT_PUBLIC_, never commit real values.
# Both use the least-privilege app role (see prisma/sql/app-role.sql), not the Neon owner.
# In Vercel, add both as Sensitive environment variables.

# Pooled (hostname contains -pooler): used by the app at runtime.
DATABASE_URL="postgresql://APP_ROLE:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&connect_timeout=15"

# Direct (no -pooler): used by the Prisma CLI and the build-time drift check.
DIRECT_URL="postgresql://APP_ROLE:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=verify-full&connect_timeout=15"
